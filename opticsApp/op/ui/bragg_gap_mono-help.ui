        <widget class="caMultiLineString" name="caMultiLineString3">
          <property name="plainText">
            <string>User can choose desired HKL indices and lattice spacing. 
 D-spacing is then recalculated and energy/wavelength 
 readbacks are updated. 

 Other crystal materials can be added via the Crystal Modes 
 button.  Once added, the main screen needs reloading for 
 the new crystals to be available. </string>
          </property>
          <property name="font">
            <string>-Liberation Sans -Regular -14</string>
          </property>
