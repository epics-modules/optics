        <widget class="caMultiLineString" name="caMultiLineString1">
          <property name="plainText">
            <string>Bragg-Gap Mono support provides energy/lambda/offset 
 control for double crystal monochromators with only the 
 bragg and gap stages. 

 It's different from the optics' modules Kohzu support 
 in that it doesn't use state notation language and simplifies 
 modes of operation. Bragg-Gap support has fixed-offset 
 and channel-cut modes (No Freeze-Z or Freeze-Y)</string>
          </property>
          <property name="font">
            <string>-Liberation Sans -Regular -14</string>
          </property>
          <property name="fontScaleMode">
            <string>None</string>
          </property>
          <property name="colorMode">
            <string>Static</string>
          </property>
          <property name="geometry">
            <rect>
              <x>10</x>
              <y>80</y>
              <width>420</width>
              <height>140</height>
            </rect>
          </property>
